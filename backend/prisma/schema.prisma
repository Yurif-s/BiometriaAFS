generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Curso {
  id     Int     @id @default(autoincrement())
  nome   String

  alunos Aluno[]
}

model Aluno {
  id        Int    @id @default(autoincrement())
  matricula String @unique
  nome      String
  ano       Int
  biometria String?

  curso_id  Int
  curso     Curso  @relation(fields: [curso_id], references: [id])
}