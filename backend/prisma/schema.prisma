generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Turma {
  id    Int    @id @default(autoincrement())
  nome  String
  ano    Int

  alunos Aluno[]
}

model Aluno {
  id        Int    @id @default(autoincrement())
  matricula String @unique
  nome      String
  biometria Int

  entrada   DateTime?
  saida     DateTime?

  turma_id  Int
  turma     Turma  @relation(fields: [turma_id], references: [id])
}