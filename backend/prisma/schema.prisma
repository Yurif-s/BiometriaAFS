generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Turma {
  id    Int    @id @default(autoincrement())
  nome  String
  ano    Int

  alunos Aluno[]
}

model Aluno {
  id        Int    @id @default(autoincrement())
  matricula String @unique
  nome      String
  biometria Int

  entrada   DateTime?
  saida     DateTime?

  turma_id  Int
  turma     Turma  @relation(fields: [turma_id], references: [id])

  acessos   Acesso[]
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  nome      String
  senha     String   // hash bcrypt
  role      String   @default("admin") // por enquanto só "admin"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Acesso {
  id        Int      @id @default(autoincrement())
  tipo      String   // "Entrada" ou "Saída"
  horario   DateTime @default(now())
  
  aluno_id  Int
  aluno     Aluno    @relation(fields: [aluno_id], references: [id], onDelete: Cascade)
}