generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Turma {
  id     Int     @id @default(autoincrement())
  nome   String
  ano    Int

  alunos Aluno[]
}

model Aluno {
  id        Int    @id @default(autoincrement())
  matricula String @unique
  nome      String
  biometria Int?

  turma_id  Int
  turma     Turma  @relation(fields: [turma_id], references: [id])
}